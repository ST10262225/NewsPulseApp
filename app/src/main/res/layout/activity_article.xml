<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp">

    <!-- Back Button -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_media_previous"
        android:contentDescription="Back"
        android:background="@android:color/transparent"
        android:layout_alignParentStart="true"
        android:layout_marginTop="8dp"/>

    <!-- Download Button -->
    <ImageButton
        android:id="@+id/btnDownload"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_menu_save"
        android:contentDescription="Download Article"
        android:background="@android:color/transparent"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="8dp"
        app:tint="@android:color/black"/>


    <!-- Article Title -->
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sample Article Title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_below="@+id/btnBack"
        android:layout_marginTop="16dp"
        android:gravity="center"/>

        <!-- Article Info -->
    <TextView
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="By Author Jan 1,2025"
        android:textSize="14sp"
        android:textColor="#777"
        android:layout_below="@+id/title"
        android:gravity="center"/>

    <!-- Article content in scrollview -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/info"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This is the article content. It will be scrollable so the user can read the full article. For now, this is just placeholder text to show how it will look in the mockup."
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"/>

        <!-- Article Image -->
        <ImageView
            android:id="@+id/ivArticle"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_below="@id/info"
            android:layout_marginTop="16dp"
            android:scaleType="centerCrop"
            android:contentDescription="Article Image"/>

    </ScrollView>


</RelativeLayout>